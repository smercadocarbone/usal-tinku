# Tinku — variables de entorno (copiar a `.env` y completar; `.env` está en .gitignore)
# Defaults compatibles con backend/src/main/resources/application.yml (perfil dev).
# Nunca commitear valores reales (README backend, seccion "Variables de entorno").

# --- Postgres (docker-compose.yml / application.yml) ---
DB_USER=tinku_dev
DB_PASSWORD=changeme

# --- JWT (autenticacion) ---
# En dev puede quedar el default, en cualquier otro ambiente debe ser un secret real.
JWT_SECRET=CAMBIAR_EN_TODOS_LOS_AMBIENTES_AL_AGREGAR_UN_SECRET_REAL

# --- M3 / T-000-06: credenciales de LiveKit Cloud ---
# URL del proyecto (ej. wss://xxx.livekit.cloud). Vacio = el backend arranca igual;
# LiveKitService falla con mensaje claro recien al usarse.
LIVEKIT_URL=
# API key y secret del proyecto en LiveKit Cloud (Consola -> Keys).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# TTL del token de acceso a la sala (parametro tecnico, no es plazo de negocio).
LIVEKIT_TOKEN_TTL_SEGUNDOS=3600

# --- M5: MercadoPago (pendiente T-000-07) ---
MP_ACCESS_TOKEN=

# --- M2: Motor de matching (servicio Python, ver matching-service/) ---
MATCHING_SERVICE_URL=http://localhost:8000

# --- M1: OCR (Tesseract, ADR-M1-01) ---
# Carpeta con spa.traineddata (ej. "$(brew --prefix tesseract)/share/tessdata").
TESSDATA_PREFIX=
OCR_IDIOMA=spa

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev